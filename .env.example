# Copiá este archivo como `.env` y ajustá el valor según tu entorno.
#   cp .env.example .env
#
# URL base del backend. En desarrollo local, apuntá a tu backend Node:
VITE_API_BASE_URL=http://localhost:8080
#
# En producción se puede omitir: si no está seteada, el frontend usa
# por defecto la URL de producción (ver src/api/apiBase.js).
