# Copiá este archivo como `.env` y ajustá el valor según tu entorno.
#   cp .env.example .env
#
# URL base del backend. En desarrollo local, apuntá a tu backend Node:
VITE_API_BASE_URL=http://localhost:8080
#
# En producción (https://ventas.soldiservicios.online) se puede omitir: si no
# está seteada, el frontend usa por defecto https://api.soldiservicios.online
# (ver src/api/apiBase.js). Si en el hosting la definís, tiene que ser esa
# misma URL: Vite la incorpora al compilar, así que un valor viejo pisaría
# el default.
